 /** Find a free port by briefly binding to port 0. */
 function getFreePort() {
   return new Promise((resolve, reject) => {
     const srv = createServer()
     srv.listen(0, '127.0.0.1', () => {
       const port = srv.address().port
       srv.close(() => resolve(port))
     })
     srv.on('error', reject)
   })
