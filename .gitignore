node_modules/
# Root build output only. Nested dist/ dirs (plugins/, fixtures/) contain
# pre-built plugin source that MUST be committed — don't ignore them.
/dist/
/packages/*/dist/
.vite/
# Dev state dir when running with `--state-dir .dev-state` manually.
.dev-state/
# Pre-extracted Electron runtime for electron-builder (electronDist). Avoids
# app-builder's zip extractor, which drops the MacOS launcher on some hosts.
.electron-dist/
coverage/
*.log
.DS_Store
.env
.env.local
.vscode/
.idea/
# Temp artifacts from the Playwright MCP dev harness.
.playwright-mcp/
/test-results/
/playwright-report/
# Local probe/worktree directories created during development.
codesclaude-react-web.*/
# Local task artifacts; Agent Notes under .agents/notes/ are committed.
.agents/tasks/
# Local Claude Code session state (plans, worktrees, settings).
.claude/
# Local-only skills (migrated from deepseek-harness); already covered by .claude/.
.claude/skills/

# Visual brainstorming mockups
.superpowers/

# Locally installed Python runtimes — not project source.
/Python/
/src/Python/

# Throwaway probes and investigation artifacts.
/.scratch/
/.tmp-investigate/
# Local design previews, throwaway prototypes and dropped-in screenshots.
/docs/*.png
/docs/*.html
/prototype/
/semantic-review/
/spike/
/plan/suggestion-animation-demo.html
/*.png
