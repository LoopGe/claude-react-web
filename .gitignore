node_modules/
# Root build output only. Nested dist/ dirs (plugins/, fixtures/) contain
# pre-built plugin source that MUST be committed — don't ignore them.
/dist/
/packages/*/dist/
.vite/
# Dev state dir when running with `--state-dir .dev-state` manually.
.dev-state/
# Pre-extracted Electron runtime for electron-builder (electronDist). Avoids
# app-builder's zip extractor, which drops the MacOS launcher on some hosts.
.electron-dist/
coverage/
*.log
.DS_Store
.env
.env.local
.vscode/
.idea/
# Temp artifacts from the Playwright MCP dev harness.
.playwright-mcp/
# Local probe/worktree directories created during development.
codesclaude-react-web.*/
# Local Claude Code session state (plans, worktrees, settings).
.claude/

# Visual brainstorming mockups
.superpowers/
